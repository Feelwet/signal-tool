#!/usr/bin/env bash
# Pre-push-krok: kjører hele pytest-suiten i et rent worktree av hver commit som skal
# pushes, og avbryter hvis exit != 0. Installeres i denne klonen med:
#   git config core.hooksPath .githooks
set -euo pipefail

if ! command -v python3 >/dev/null; then
  echo "pre-push: python3 mangler" >&2
  exit 1
fi

rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ -z "${local_sha:-}" || "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  wt="$(mktemp -d /tmp/st-prepush.XXXXXX)"
  echo "pre-push: pytest for ${local_ref} ${local_sha:0:12} i rent worktree"
  if ! git worktree add --detach "$wt" "$local_sha" >/tmp/st-prepush-wt.log 2>&1; then
    echo "pre-push: kunne ikke lage worktree for $local_sha" >&2
    cat /tmp/st-prepush-wt.log >&2
    rm -rf "$wt"
    exit 1
  fi
  set +e
  (cd "$wt" && python3 -m pytest -q)
  prc=$?
  set -e
  git worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
  if [[ $prc -ne 0 ]]; then
    echo "pre-push: suiten feilet (exit $prc) for $local_sha — push avbrutt" >&2
    exit "$prc"
  fi
done
exit 0
